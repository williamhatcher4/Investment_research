# Which research provider to use: "tavily" (default, cheaper) or "perplexity".
RESEARCH_PROVIDER=tavily

# Required if RESEARCH_PROVIDER=tavily (https://tavily.com/)
TAVILY_API_KEY=

# Required if RESEARCH_PROVIDER=perplexity (https://docs.perplexity.ai/)
PERPLEXITY_API_KEY=

# Optional: Financial Modeling Prep API key (https://site.financialmodelingprep.com/)
# When unset, tools omit the FMP-sourced structured financial block.
FMP_API_KEY=

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Optional: Perplexity model when RESEARCH_PROVIDER=perplexity. Defaults to sonar-pro.
PERPLEXITY_MODEL=sonar-pro

# Optional: Tavily search depth ("basic" = 1 credit, "advanced" = 2 credits).
TAVILY_SEARCH_DEPTH=advanced

# SEC EDGAR requires a contact User-Agent for free programmatic access.
# Format: "Application-Name your-email@example.com".
SEC_EDGAR_USER_AGENT=investor-research-mcp contact@example.com

# --- Local research vault (Phase 3) ---
# Path to the Obsidian-compatible vault folder. Leave unset to disable
# the vault tools entirely. Relative paths resolve from the working
# directory the server is launched from.
VAULT_ROOT=location/to/vault

# When true (default), import_xlsx_export and write_memo_to_vault refresh
# the SQLite cross-company index after each write. Set to false to skip
# the index entirely — JSON in parsed/ remains the canonical store.
ENABLE_SQLITE=true
